# Backend API base URL. The SPA calls this cross-origin (cookies: credentials
# include) and also resolves /static/img/<name> against it. Baked at BUILD time
# by Vite, so on Railway set it as a build ARG / build-time variable, NOT a
# runtime var.
#   local dev:  VITE_API_URL=http://localhost:8000   (or your local backend port)
#   prod:       VITE_API_URL=https://<backend-domain>  (exact, no trailing slash)
VITE_API_URL=http://localhost:8000
