DATABASE_URL=postgresql://postgres:postgres@localhost:5432/klktv_cocktails

# Generate via: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# Comma-separated allowed origins for CORS
CORS_ORIGINS=http://localhost:5173

# Cookies: in local dev with http set false + samesite=lax
# In prod (HTTPS, cross-origin) keep secure=true + samesite=none
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

ACCESS_TOKEN_EXPIRE_HOURS=24

# Where uploaded + served images live (/static/img/<name>). In prod this is a
# Railway VOLUME mount path so uploads survive redeploys; the baked seed_media
# set auto-populates an empty volume on boot.
UPLOAD_DIR=/app/uploads

# ── Production (Railway) — set these in the service's Variables ──────────
# SECRET_KEY=<64-char random, e.g. python -c "import secrets;print(secrets.token_urlsafe(48))">
# DATABASE_URL=<v2-prod Postgres URL (tokaido)>
# CORS_ORIGINS=https://<frontend-domain>     # exact origin(s), comma-separated, NO trailing slash
# COOKIE_SECURE=true                          # HTTPS cross-origin
# COOKIE_SAMESITE=none                        # required for cross-origin cookie auth
# UPLOAD_DIR=/app/uploads                      # attach a Railway Volume mounted here
# DEBUG=false                                  # keep Swagger/OpenAPI closed in prod
# See docs/DEPLOY.md for the full runbook.
